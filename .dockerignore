# The build context is the whole repository. Without this file the final
# `COPY . .` in the Dockerfile would bake `.env` -- which holds the database
# password -- into an image layer, where it survives `docker rmi` of later
# layers and leaks the moment the image is pushed anywhere.
.env
.env.*
!.env.example

# Version control and local Python environments
.git
.gitignore
.venv
venv

# Build and tool caches
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# reports/results.md and reports/figures/*.png are delivered artefacts and must
# stay in the build context so `COPY . .` can put them in the image. Only
# intermediate run logs are excluded.
reports/runs/
