# Copy to .env and adjust. All keys are prefixed APEX_ (see src/config.py).
# Every value below is also the built-in default, so an empty .env works.
#
# Inside `docker compose`, the app reaches PostgreSQL at host `db` -- the compose
# file already sets APEX_PG_HOST for that. The values below are the host-side
# defaults, used when you run the CLI outside a container.

# --- PostgreSQL -------------------------------------------------------------
APEX_PG_HOST=localhost
APEX_PG_PORT=5432
APEX_PG_USER=apex
APEX_PG_PASSWORD=apex
APEX_PG_DATABASE=apex_rag
APEX_PG_CONNECT_TIMEOUT=10

# Optional: one connection string instead of the five fields above. It wins
# when set, and is the easiest way to point the benchmark at an existing
# database. NOTE: it also overrides APEX_PG_HOST, so a value holding
# `localhost` will break the containerised path -- leave it commented out
# unless you are deliberately targeting another database.
# DATABASE_URL=postgresql://apex:apex@localhost:5432/apex_rag

# --- HNSW bootstrap index ---------------------------------------------------
# Read only by docker/init.sh, and only when the data directory is empty.
# Changing them requires `make reset`. Phase 4's indexer.py rebuilds the index
# with swept values and takes over from there.
APEX_HNSW_M=16
APEX_HNSW_EF_CONSTRUCTION=64

# --- Embedding --------------------------------------------------------------
# Local model by default: no API key, so `docker compose up` reproduces the
# published numbers on any machine. Fallbacks:
#   BAAI/bge-large-en-v1.5       1024 dims  (default, best quality)
#   all-MiniLM-L6-v2              384 dims  (fast / small, dims must be updated)
#
# APEX_EMBEDDING_DIM must equal chunks.embedding's declared width. Changing the
# model to one with a different width therefore means recreating that column --
# `make db-check` reports the mismatch rather than letting it slide.
APEX_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
APEX_EMBEDDING_DIM=1024
APEX_EMBEDDING_DEVICE=cpu
APEX_EMBEDDING_BATCH_SIZE=32
# Attempts per batch before the import aborts. Backoff is 1s, then 2s, then 4s.
APEX_EMBEDDING_MAX_RETRIES=3

# --- Ingestion --------------------------------------------------------------
# The corpus is fixed at 150 documents; the loader fails if the file disagrees,
# so a truncated or swapped file cannot be imported quietly.
APEX_EXPECTED_DOCUMENT_COUNT=150

# --- Reranker ---------------------------------------------------------------
# BAAI/bge-reranker-base                        (quality)
# cross-encoder/ms-marco-MiniLM-L-6-v2          (fast)
APEX_RERANKER_MODEL=BAAI/bge-reranker-base
APEX_RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
APEX_RERANKER_DEVICE=cpu
APEX_RERANKER_BATCH_SIZE=16
APEX_RERANKER_MAX_LENGTH=512
# Refuse Hugging Face network access and load only from the local cache.
# Set to false (or pass --allow-network) if the model is not cached yet.
APEX_RERANKER_LOCAL_FILES_ONLY=true
APEX_RERANKER_CACHE_FOLDER=.cache/huggingface/hub

# --- Generation provider (Phase 8) -----------------------------------------
# OpenAI-compatible endpoint. The key is never committed, logged or written to
# reports. Leave it unset to use the deterministic mock provider; the real
# provider then fails fast with a clear configuration error.
# APEX_LLM_API_KEY=
# DEEPSEEK_API_KEY is also accepted as an alias for APEX_LLM_API_KEY.
APEX_LLM_BASE_URL=https://api.deepseek.com
APEX_LLM_MODEL=deepseek-chat
APEX_LLM_CONNECT_TIMEOUT=5
APEX_LLM_READ_TIMEOUT=60
# Retries after the first attempt; total attempts = retries + 1.
APEX_LLM_MAX_RETRIES=2
APEX_LLM_TEMPERATURE=0
APEX_LLM_MAX_TOKENS=512

# --- RAG answer chain (Phase 8) --------------------------------------------
APEX_RAG_CANDIDATES=10
APEX_RAG_TOP_K=10
APEX_RAG_MAX_CONTEXT_CHARS=8000
APEX_RAG_MAX_CHUNK_CHARS=2000
